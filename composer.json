{
  "name": "student-org/expense-tracker",
  "description": "A simple, persistent command-line expense tracker for student organizations.",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "ExpenseTracker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ExpenseTracker\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
